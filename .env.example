# Frontend: pode ser exposto no bundle, pois é a chave pública do Supabase.
VITE_LOCAL_MODE=false
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=cole_a_anon_key_aqui
VITE_SUPABASE_BUCKET=casinha-media

# Backend Vercel: configure estes mesmos valores em Project Settings > Environment Variables.
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_ANON_KEY=cole_a_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=cole_a_service_role_key_aqui
SHARE_TOKEN_SECRET=uma_chave_secreta_estavel_para_links
SUPABASE_BUCKET=casinha-media
APP_ORIGIN=https://seu-dominio.vercel.app
MAX_STORAGE_BYTES=524288000

# Pagamentos (Mercado Pago Checkout Pro / Orders API) — SOMENTE server-side.
# Nunca use prefixo VITE_ nestas variáveis. Veja docs/pagamentos-mercado-pago.md.
MERCADO_PAGO_ACCESS_TOKEN=cole_o_access_token_de_TESTE_aqui
MERCADO_PAGO_WEBHOOK_SECRET=cole_a_assinatura_secreta_do_webhook_aqui
# test (padrão) ou production. Cobrança real só com "production" + credenciais de produção.
MERCADO_PAGO_ENV=test
